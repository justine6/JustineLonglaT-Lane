{
  "name": "justine-longla-t-lane",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:links": "node tools/validate-links.mjs",
    "lint": "eslint .",
    "deps:check": "pnpm outdated",
    "deps:audit": "pnpm audit",
    "deps:update": "pnpm update",
    "prepare": "husky",
    "check-all": "node tools/run-ps.cjs scripts/check-dictionaries.ps1 && node tools/run-ps.cjs scripts/validate-and-repair-json.ps1",
    "patch-missing": "node tools/run-ps.cjs scripts/patch-missing.ps1",
    "fix-footer": "node tools/run-ps.cjs scripts/fix-footer.ps1",
    "patch-all": "pnpm run patch-missing && pnpm run fix-footer",
    "repair": "pnpm run patch-all && pnpm run check-all",
    "repair:quick": "pnpm run patch-all && pnpm run check-all",
    "sync": "node tools/run-ps.cjs scripts/sync-dicts.ps1",
    "sync:verbose": "node tools/run-ps.cjs scripts/sync-dicts.ps1 -ShowSkipped",
    "update-dicts:full": "node tools/run-ps.cjs scripts/Update-Dictionaries-Full.ps1",
    "update-dicts:incremental": "node tools/run-ps.cjs scripts/Update-Dictionaries-Incremental.ps1",
    "generate-types": "node tools/run-ps.cjs scripts/generate-types.ps1",
    "test:run": "vitest run",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:strict": "vitest run --coverage --passWithNoTests=false",
    "ci-check": "pnpm run lint && pnpm run coverage:strict",
    "ci-repair": "pnpm run repair && pnpm run lint && pnpm run coverage:strict",
    "test:ci": "pnpm run coverage:strict",
    "generate:brand-icons": "node tools/generate-brand-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@next/mdx": "^16.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.9.19",
    "esbuild": "0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "playwright": "^1.56.1",
    "postcss": "^8.5.26",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.18",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.55.0",
    "vite": "8.2.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@calcom/embed-react": "^1.5.3",
    "@clerk/nextjs": "^7.7.1",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.6",
    "@vercel/blob": "^2.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.545.0",
    "marked": "^17.0.1",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.1",
    "postgres": "^3.4.9",
    "react": "^19.2.3",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-scrollspy": "^3.4.3",
    "resend": "^6.18.1",
    "stripe": "^20.4.1",
    "swiper": "^12.1.2",
    "zod": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "gray-matter>js-yaml": "3.15.1",
      "mdast-util-to-hast": "13.2.1",
      "glob@^10": "10.5.0",
      "flatted@^3": "3.4.4",
      "js-yaml@^4": "4.3.1",
      "minimatch@^9": "9.0.9",
      "minimatch@^3": "3.1.4",
      "brace-expansion@^2": "2.1.4",
      "brace-expansion@^1": "1.1.18",
      "ws@^8": "8.21.0",
      "@babel/core": "7.29.6",
      "ajv": "6.14.0"
    }
  }
}
